# Copy this file to `.env` and fill in a real key. `.env` is gitignored.
#   copy .env.example .env     (Windows)
#   cp   .env.example .env     (Linux/macOS)
#
# Put values on their own line with nothing after them.

# Which model drives the agent: gemini  or  anthropic
ABAGENT_PROVIDER=gemini

# Gemini (free tier): get a key at https://aistudio.google.com/apikey
# Paste the key exactly as AI Studio shows it, with nothing after it.
GEMINI_API_KEY=

# Claude: get a key at https://console.anthropic.com  (needs prepaid credit)
# It looks like sk-ant-...
ANTHROPIC_API_KEY=

# Optional: override the model name
# ABAGENT_MODEL=gemini-3.8-flash
