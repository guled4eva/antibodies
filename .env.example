# Copy this file to `.env` and fill in a real key. `.env` is gitignored.
#   cp .env.example .env   &&   edit it
#
# Pick which model the agent uses:
ABAGENT_PROVIDER=gemini          # or: anthropic

# Gemini (free tier): get a key at https://aistudio.google.com/apikey
# It looks like AIzaSy...  (NOT an AQ.* OAuth token)
GEMINI_API_KEY=

# Claude: get a key at https://console.anthropic.com  (needs prepaid credit)
# It looks like sk-ant-...
ANTHROPIC_API_KEY=

# Optional: override the model name
# ABAGENT_MODEL=gemini-2.0-flash
